# =============================================================================
# Variables de entorno de ejemplo - Taller Evaluado II (ICINF1108)
# =============================================================================
# 1. Copia este archivo como .env:
#      PowerShell:  Copy-Item .env.example .env
# 2. Reemplaza las contraseñas ficticias por contraseñas propias en .env.
# 3. NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
#
# Todos los valores de este archivo son de EJEMPLO y no deben usarse
# en un entorno real.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (servicio "db")
# -----------------------------------------------------------------------------
# Nombre de la base de datos que se crea al iniciar el contenedor por primera vez.
POSTGRES_DB=students_pets
# Usuario administrador de la base de datos.
POSTGRES_USER=students_admin
# Contraseña ficticia: cámbiala en tu .env.
POSTGRES_PASSWORD=cambia_esta_clave_postgres
# Puerto del equipo (host) que se publica hacia el puerto interno 5432.
# Si ya tienes PostgreSQL instalado en Windows, usa otro (por ejemplo 5433).
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# pgAdmin (servicio "pgadmin")
# -----------------------------------------------------------------------------
# Correo con el que se inicia sesión en pgAdmin (debe tener formato válido).
PGADMIN_DEFAULT_EMAIL=admin@example.com
# Contraseña ficticia: cámbiala en tu .env.
PGADMIN_DEFAULT_PASSWORD=cambia_esta_clave_pgadmin
# Puerto del equipo para abrir pgAdmin en el navegador (http://localhost:5050).
PGADMIN_PORT=5050

# -----------------------------------------------------------------------------
# FastAPI
# -----------------------------------------------------------------------------
# Puerto del equipo que se publica hacia el puerto interno 3000 de la API.
API_PORT=3000

# URL de conexión que usa SQLAlchemy (controlador psycopg 3).
# Formato: postgresql+psycopg://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
#  - Ejecutando la API en tu equipo (uv run ...):  HOST=localhost, PUERTO=POSTGRES_PORT
#  - Ejecutando la API dentro de Docker:           HOST=db,        PUERTO=5432
# Debe coincidir con POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_PORT y POSTGRES_DB.
# Si la contraseña tiene caracteres especiales (@ : / # ? %), codifícalos
# en la URL (por ejemplo @ -> %40).
DATABASE_URL=postgresql+psycopg://students_admin:cambia_esta_clave_postgres@localhost:5432/students_pets